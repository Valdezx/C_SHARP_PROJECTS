@page "/catalog"
@using System.Net.Http.Json
@using PcShop.WEB.Models
@inject HttpClient Http
@inject PcShop.WEB.Services.CartService CartService

<PageTitle>Каталог товарів</PageTitle>

<div class="container mt-4">
    <h2 class="mb-4">Каталог комплектуючих</h2>

    @if (products == null)
    {
        <div class="d-flex align-items-center gap-2">
            <div class="spinner-border text-primary" role="status"></div>
            <span>Завантаження товарів з API...</span>
        </div>
    }
    else if (!products.Any())
    {
        <div class="alert alert-warning">Наразі немає доступних товарів у магазині.</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var product in products)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title text-primary">@product.Name</h5>
                                @if (!string.IsNullOrEmpty(product.CategoryName))
                                {
                                    <span class="badge bg-secondary">@product.CategoryName</span>
                                }
                            </div>
                            <p class="card-text text-muted flex-grow-1">@product.Description</p>
                            <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                                <span class="fs-5 fw-bold text-dark">@product.Price.ToString("N0") ₴</span>
                                <span class="badge @(product.StockQuantity > 0 ? "bg-success" : "bg-danger")">
                                    @(product.StockQuantity > 0 ? $"В наявності: {product.StockQuantity}" : "Немає в наявності")
                                </span>
                            </div>
                            <button class="btn btn-outline-primary w-100 mt-3"
                                    disabled="@(product.StockQuantity == 0)"
                                    @onclick="() => AddToCart(product)">
                                Додати до кошика
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<ProductDto>? products;
    private void AddToCart(ProductDto product)
    {
        CartService.AddToCart(product);
    }
    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Робимо GET-запит до нашого Web API
            products = await Http.GetFromJsonAsync<List<ProductDto>>("api/products");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Помилка завантаження даних: {ex.Message}");
            products = new List<ProductDto>();

        }
    }
}