@using PcShop.WEB.Services
@inject CartService CartService
@implements IDisposable

<nav class="navbar navbar-expand bg-dark navbar-dark shadow-sm py-2">
    <div class="container d-flex justify-content-between align-items-center">
        <!-- Логотип та навігаційні посилання -->
        <div class="d-flex align-items-center gap-4">
            <NavLink class="navbar-brand m-0 fw-bold d-flex align-items-center gap-2" href="">
                <span class="text-warning">⚡</span> YES!PC
            </NavLink>

            <div class="d-flex align-items-center gap-2">
                <NavLink class="btn btn-sm btn-outline-secondary text-white border-0 px-3 py-2" href="" Match="NavLinkMatch.All">
                    Головна
                </NavLink>
                <NavLink class="btn btn-sm btn-outline-secondary text-white border-0 px-3 py-2" href="catalog">
                    Каталог товарів
                </NavLink>
            </div>
        </div>

        <!-- Кнопка кошика праворуч -->
        <div>
            <NavLink class="btn btn-primary d-flex align-items-center gap-2 px-3 py-2 position-relative" href="cart">
                <span>🛒 Кошик</span>
                @if (CartService.GetTotalCount() > 0)
                {
                    <span class="badge bg-danger rounded-pill">
                        @CartService.GetTotalCount()
                    </span>
                }
            </NavLink>
        </div>
    </div>
</nav>

@code {
    protected override void OnInitialized()
    {
        CartService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        CartService.OnChange -= StateHasChanged;
    }
}