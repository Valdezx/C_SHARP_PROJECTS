<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="taekwondo_app.MainPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="Black"
             >

    <Grid RowDefinitions="Auto, *" ColumnDefinitions="*">
        <Label Text="Welcome to the Taekwondo App!"
               FontSize="24"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               Grid.Row="0" />
        <StackLayout Grid.Row="2" Padding="20">
            
            <Button x:Name="ViewFormsButton"
                    BackgroundColor="Black"
                    BorderColor="Orange"
                    BorderWidth="2"
                    HeightRequest="60"
                    Text="Туль"
                    TextColor="Orange"
                    Clicked="ViewFormsButton_Clicked"
                    Margin="0,10" />
            <Button x:Name="ViewSparringButton"
                    BackgroundColor="Black"
                    BorderColor="Orange"
                    HeightRequest="60"
                    BorderWidth="2"
                    Text="Спаринг"
                    TextColor="Orange"
                    Clicked="ViewSparringButton_Clicked"
                    Margin="0,10" />
        </StackLayout>
    </Grid>
</ContentPage>
