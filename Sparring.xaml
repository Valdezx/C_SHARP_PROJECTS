<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="taekwondo_app.Sparring"
             Title="Sparring"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="Black"
             >
    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Стиль для синіх кнопок додавання балів -->
            <Style x:Key="BlueScoreButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#1E88E5" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HeightRequest" Value="40" />
            </Style>

            <!-- Стиль для червоних кнопок додавання балів -->
            <Style x:Key="RedScoreButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#E53935" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HeightRequest" Value="40" />
            </Style>

            <!-- Стиль для кнопок зауважень та штрафів -->
            <Style x:Key="PenaltyButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#424242" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HeightRequest" Value="38" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto" Padding="15" RowSpacing="10">

        <!-- ВЕРХНЯ ПАНЕЛЬ: ТАБЛО ТА ШТРАФИ -->
        <Grid Grid.Row="0" ColumnDefinitions="*, *" ColumnSpacing="15">
            <!-- Синій кут -->
            <Border Grid.Column="0" BackgroundColor="#1E1E1E" Stroke="#1E88E5" StrokeThickness="2" StrokeShape="RoundRectangle 10" Padding="10">
                <VerticalStackLayout Spacing="2">
                    <Label Text="СИНІЙ" TextColor="#1E88E5" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label x:Name="BlueTotalLabel" Text="0" TextColor="#1E88E5" FontSize="42" FontAttributes="Bold" HorizontalOptions="Center" />

                    <!-- Рядок із штрафами під балами -->
                    <Label x:Name="BluePenaltiesLabel" Text="Штрафи: 0 | Зауваження: 0/3" TextColor="#FFB74D" FontSize="12" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Червоний кут -->
            <Border Grid.Column="1" BackgroundColor="#1E1E1E" Stroke="#E53935" StrokeThickness="2" StrokeShape="RoundRectangle 10" Padding="10">
                <VerticalStackLayout Spacing="2">
                    <Label Text="ЧЕРВОНИЙ" TextColor="#E53935" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label x:Name="RedTotalLabel" Text="0" TextColor="#E53935" FontSize="42" FontAttributes="Bold" HorizontalOptions="Center" />

                    <!-- Рядок із штрафами під балами -->
                    <Label x:Name="RedPenaltiesLabel" Text="Штрафи: 0 | Зауваження: 0/3" TextColor="#FFB74D" FontSize="12" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ОСНОВНИЙ БЛОК: КНОПКИ ТА ІСТОРІЯ В ДВІ КОЛОНКИ -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="15">

            <!-- ЛІВА КОЛОНКА (СИНІЙ БІЄЦЬ) -->
            <Grid Grid.Column="0" RowDefinitions="Auto, *" RowSpacing="8">
                <VerticalStackLayout Grid.Row="0" Spacing="6">
                    <Button x:Name="OneBluePoint" Text="+1" Style="{StaticResource BlueScoreButtonStyle}" Clicked="OneBluePoint_Clicked" />
                    <Button x:Name="TwoBluePoint" Text="+2" Style="{StaticResource BlueScoreButtonStyle}" Clicked="TwoBluePoint_Clicked" />
                    <Button x:Name="ThreeBluePoint" Text="+3" Style="{StaticResource BlueScoreButtonStyle}" Clicked="ThreeBluePoint_Clicked" />
                    <Button x:Name="FourBluePoint" Text="+4" Style="{StaticResource BlueScoreButtonStyle}" Clicked="FourBluePoint_Clicked" />
                    <Button x:Name="FiveBluePoint" Text="+5" Style="{StaticResource BlueScoreButtonStyle}" Clicked="FiveBluePoint_Clicked" />

                    <!-- Кнопки: Зауваження, -1 бал та Скасувати -->
                    <Button Text="Зауваження" Style="{StaticResource PenaltyButtonStyle}" Clicked="BlueWarning_Clicked" />
                    <Button Text="-1 Бал" Style="{StaticResource PenaltyButtonStyle}" Clicked="BlueMinusOne_Clicked" />
                    <Button Text="↩ Скасувати дію" BackgroundColor="#212121" TextColor="#9E9E9E" FontSize="12" HeightRequest="32" Clicked="BlueUndo_Clicked" />
                </VerticalStackLayout>

                <!-- Історія балів -->
                <Border Grid.Row="1" BackgroundColor="#1A1A1A" StrokeShape="RoundRectangle 8" Padding="8">
                    <ScrollView>
                        <VerticalStackLayout x:Name="BlueHistoryLayout" Spacing="4" />
                    </ScrollView>
                </Border>
            </Grid>

            <!-- ПРАВА КОЛОНКА (ЧЕРВОНИЙ БІЄЦЬ) -->
            <Grid Grid.Column="1" RowDefinitions="Auto, *" RowSpacing="8">
                <VerticalStackLayout Grid.Row="0" Spacing="6">
                    <Button x:Name="OneRedPoint" Text="+1" Style="{StaticResource RedScoreButtonStyle}" Clicked="OneRedPoint_Clicked" />
                    <Button x:Name="TwoRedPoint" Text="+2" Style="{StaticResource RedScoreButtonStyle}" Clicked="TwoRedPoint_Clicked" />
                    <Button x:Name="ThreeRedPoint" Text="+3" Style="{StaticResource RedScoreButtonStyle}" Clicked="ThreeRedPoint_Clicked" />
                    <Button x:Name="FourRedPoint" Text="+4" Style="{StaticResource RedScoreButtonStyle}" Clicked="FourRedPoint_Clicked" />
                    <Button x:Name="FiveRedPoint" Text="+5" Style="{StaticResource RedScoreButtonStyle}" Clicked="FiveRedPoint_Clicked" />

                    <!-- Кнопки: Зауваження, -1 бал та Скасувати -->
                    <Button Text="Зауваження" Style="{StaticResource PenaltyButtonStyle}" Clicked="RedWarning_Clicked" />
                    <Button Text="-1 Бал" Style="{StaticResource PenaltyButtonStyle}" Clicked="RedMinusOne_Clicked" />
                    <Button Text="↩ Скасувати дію" BackgroundColor="#212121" TextColor="#9E9E9E" FontSize="12" HeightRequest="32" Clicked="RedUndo_Clicked" />
                </VerticalStackLayout>

                <!-- Історія балів -->
                <Border Grid.Row="1" BackgroundColor="#1A1A1A" StrokeShape="RoundRectangle 8" Padding="8">
                    <ScrollView>
                        <VerticalStackLayout x:Name="RedHistoryLayout" Spacing="4" />
                    </ScrollView>
                </Border>
            </Grid>

        </Grid>

        <!-- НИЖНЯ ПАНЕЛЬ: ПОВЕРНЕННЯ ТА СКИНУТИ РАХУНОК -->
        <Grid Grid.Row="2" ColumnDefinitions="*, *" ColumnSpacing="10">

            <Button Grid.Column="0"
                    Text="← На головну" 
                    BackgroundColor="#1E1E1E" 
                    TextColor="White" 
                    FontSize="14" 
                    CornerRadius="8"
                    HeightRequest="42"
                    Clicked="OnBackToMainClicked" />

            <Button Grid.Column="1"
                    Text="Скинути рахунок" 
                    BackgroundColor="#2E2E2E" 
                    TextColor="#E53935" 
                    FontSize="14" 
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="42"
                    Clicked="OnResetClicked" />
        
        </Grid>

    </Grid>

</ContentPage>