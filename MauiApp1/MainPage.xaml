<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.MainPage">
    <FlexLayout Direction="Column">
        <Label x:Name="PasswordLabel" Text="Password" HorizontalOptions="Center" FontSize="24" FontFamily="Sans Serif" FontAttributes="Bold"*/>
        <Stepper x:Name="PasswordStepper" Minimum="4" Maximum="20"  HorizontalOptions="Center" WidthRequest="200" Increment="1" ValueChanged="PasswordStepper_ValueChanged" />
        <Label x:Name="PasswordLengthLabel" Text="Password Length: 4" HorizontalOptions="Center" FontSize="18" FontFamily="Sans Serif"/>
        <Button Text="Generate password" Clicked="Button_Clicked"/>
        <Label x:Name="GeneratedPasswordLabel" Text="Generated Password: " HorizontalOptions="Center" FontSize="18" FontFamily="Sans Serif"/>


        
    </FlexLayout>

</ContentPage>